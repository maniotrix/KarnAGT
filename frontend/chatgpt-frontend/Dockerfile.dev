# =============================================================================
# Frontend Development Dockerfile
# =============================================================================
# Multi-stage build for development React application
# Same structure as production but with development-specific args

# Build stage - Node.js environment for building React app
FROM node:20.18.0-alpine AS build

# Set working directory
WORKDIR /app

# Install system dependencies for building
RUN apk add --no-cache git

# Accept build arguments from docker-compose
ARG VITE_API_URL=https://localhost
ARG NODE_ENV=development

# Copy package files for efficient caching
COPY package*.json ./

# Install dependencies (including dev dependencies for build)
RUN npm ci --include=dev

# Set build environment variables
ENV NODE_ENV=$NODE_ENV
ENV VITE_API_URL=$VITE_API_URL

# Copy source code
COPY . .

# Build the React application for development
RUN npm run build

# =============================================================================
# Development stage - Nginx for serving static files
# =============================================================================
FROM nginx:1.25.3-alpine AS development

# Accept build arguments
ARG FRONTEND_USER=app_frontend_dev

# Install dependencies and setup user in single layer
RUN apk add --no-cache curl && \
    addgroup -g 1001 -S $FRONTEND_USER && \
    adduser -S $FRONTEND_USER -u 1001 -G $FRONTEND_USER && \
    mkdir -p /var/cache/nginx /var/run/nginx && \
    sed -i '/^user/d' /etc/nginx/nginx.conf

# Copy built assets from build stage
COPY --from=build --chown=$FRONTEND_USER:$FRONTEND_USER /app/build /usr/share/nginx/html

# Copy nginx configuration for React SPA routing
COPY --chown=$FRONTEND_USER:$FRONTEND_USER nginx.conf /etc/nginx/conf.d/default.conf

# Set final permissions in single layer
RUN chown -R $FRONTEND_USER:$FRONTEND_USER /var/cache/nginx /var/run/nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose port 3000 (internal container port)
EXPOSE 3000

# Switch to non-root user
USER $FRONTEND_USER

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]