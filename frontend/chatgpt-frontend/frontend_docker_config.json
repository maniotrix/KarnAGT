{
  "project_name": "app-frontend",
  "description": "Application Frontend Docker Environment Configuration with Traefik Integration",
  "environments": {
    "dev": {
      "compose_file": "docker-compose.dev.yml",
      "dockerfile": "Dockerfile.dev", 
      "service_name": "app-frontend-dev",
      "description": "Development environment with hot reload and volume mounts",
      "network": "dev-network",
      "domain": "localhost",
      "ssl_mode": "self-signed"
    },
    "staging": {
      "compose_file": "docker-compose.staging.yml",
      "dockerfile": "Dockerfile.staging",
      "service_name": "app-frontend-staging",
      "description": "Staging environment for pre-production testing",
      "network": "staging-network",
      "domain": "staging.yourdomain.com",
      "ssl_mode": "letsencrypt"
    },
    "prod": {
      "compose_file": "docker-compose.prod.yml",
      "dockerfile": "Dockerfile.prod",
      "service_name": "app-frontend-prod", 
      "description": "Production environment with optimized build and performance",
      "network": "prod-network",
      "domain": "yourdomain.com",
      "ssl_mode": "letsencrypt"
    }
  },
  "default_environment": "dev",
  "traefik": {
    "enabled": true,
    "routing_strategy": "host_based",
    "priority": 1,
    "security": {
      "exposed_by_default": false,
      "security_headers": true,
      "ssl_redirect": true
    },
    "routing": {
      "dev": "Host(`localhost`) && !PathPrefix(`/api`)",
      "staging": "Host(`staging.yourdomain.com`)",
      "prod": "Host(`yourdomain.com`)"
    }
  },
  "service": {
    "internal_port": 3000,
    "health_check": "/",
    "description": "React frontend application served via Traefik"
  },
  "build": {
    "target": {
      "dev": "development",
      "staging": "production", 
      "prod": "production"
    },
    "args": {
      "dev": {
        "VITE_API_URL": "https://localhost",
        "NODE_ENV": "development"
      },
      "staging": {
        "VITE_API_URL": "https://api-staging.yourdomain.com",
        "NODE_ENV": "production"
      },
      "prod": {
        "VITE_API_URL": "https://api.yourdomain.com", 
        "NODE_ENV": "production"
      }
    }
  },
  "dependencies": {
    "required_networks": {
      "dev": "dev-network",
      "staging": "staging-network", 
      "prod": "prod-network"
    },
    "created_by": {
      "dev": "Database services (db_manager.py)",
      "staging": "Database services (db_manager.py)",
      "prod": "Database services (db_manager.py)"
    },
    "startup_order": ["database", "codesandbox", "backend", "frontend"]
  },
  "settings": {
    "docker_compose_timeout": 300,
    "build_timeout": 600,
    "startup_wait_time": 10,
    "health_check_timeout": 120,
    "network_isolation": true,
    "resource_limits": {
      "memory": "512m",
      "cpu": "0.5"
    }
  }
}
