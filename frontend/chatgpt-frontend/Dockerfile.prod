# =============================================================================
# Frontend Production Dockerfile
# =============================================================================
# Multi-stage build for optimized production React application
# Builds static assets and serves them with lightweight nginx

# Build stage - Node.js environment for building React app
FROM node:18-alpine AS build

# Set working directory
WORKDIR /app

# Install system dependencies for building
RUN apk add --no-cache git

# Accept build arguments from docker-compose
ARG VITE_API_URL=https://api.yourdomain.com
ARG NODE_ENV=production

# Copy package files for efficient caching
COPY package*.json ./

# Install dependencies (including dev dependencies for build)
RUN npm ci --include=dev

# Set build environment variables
ENV NODE_ENV=$NODE_ENV
ENV VITE_API_URL=$VITE_API_URL

# Copy source code
COPY . .

# Build the React application for production
RUN npm run build

# =============================================================================
# Production stage - Nginx for serving static files
# =============================================================================
FROM nginx:1.25-alpine AS production

# Accept build arguments
ARG FRONTEND_USER=app_frontend_prod

# Install curl for health checks
RUN apk add --no-cache curl

# Create the same user as build stage
RUN addgroup -g 1001 -S $FRONTEND_USER && \
    adduser -S $FRONTEND_USER -u 1001 -G $FRONTEND_USER

# Copy built assets from build stage
COPY --from=build --chown=$FRONTEND_USER:$FRONTEND_USER /app/build /usr/share/nginx/html

# Copy nginx configuration for React SPA routing
COPY --chown=$FRONTEND_USER:$FRONTEND_USER nginx.conf /etc/nginx/conf.d/default.conf

# Create necessary directories and set permissions
RUN mkdir -p /var/cache/nginx /var/run/nginx && \
    chown -R $FRONTEND_USER:$FRONTEND_USER /var/cache/nginx /var/run/nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Remove default nginx user directive and run as non-root
RUN sed -i '/^user/d' /etc/nginx/nginx.conf

# Expose port 3000 (internal container port)
EXPOSE 3000

# Switch to non-root user
USER $FRONTEND_USER

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
