{
  "description": "Database infrastructure with Traefik integration, unified networking, and password security validation",
  "supported_environments": ["dev", "staging", "prod", "prod_aws"],
  "environments": {
    "dev": {
      "compose_file": "docker-compose.dev.yml",
      "description": "Development database with debug settings",
      "network": "dev-network",
      "domain": "localhost",
      "ssl_mode": "self-signed"
    },
    "staging": {
      "compose_file": "docker-compose.staging.yml",
      "description": "Staging database - production mirror",
      "network": "staging-network",
      "domain": "staging.yourdomain.com",
      "ssl_mode": "letsencrypt"
    },
    "prod": {
      "compose_file": "docker-compose.prod.yml",
      "description": "Production database with high availability",
      "network": "prod-network",
      "domain": "yourdomain.com",
      "ssl_mode": "letsencrypt"
    },
    "prod_aws": {
      "compose_file": "docker-compose-prod-aws.yml",
      "description": "Production database with EBS volumes on AWS EC2",
      "network": "prod_aws_network",
      "domain": "karnagt.com",
      "ssl_mode": "letsencrypt"
    }
  },
  "services": {
    "postgres": {
      "container_name_suffix": "_dev|_staging|_prod",
      "internal_port": 5432,
      "traefik_enabled": false,
      "description": "PostgreSQL database - internal only"
    },
    "redis": {
      "container_name_suffix": "_dev|_staging|_prod",
      "internal_port": 6379,
      "traefik_enabled": false,
      "description": "Redis cache - internal only"
    },
    "neo4j": {
      "container_name_suffix": "_dev|_staging|_prod",
      "internal_ports": [7474, 7687],
      "traefik_enabled": false,
      "description": "Neo4j graph database - internal only"
    },
    "qdrant": {
      "container_name_suffix": "_dev|_staging|_prod",
      "internal_ports": [6333, 6334],
      "traefik_enabled": false,
      "description": "Qdrant vector database - internal only"
    },
    "minio": {
      "container_name_suffix": "_dev|_staging|_prod",
      "internal_port": 9000,
      "console_port": 9001,
      "traefik_enabled": true,
      "path_prefix": "/files",
      "description": "MinIO object storage - public file access via Traefik"
    }
  },
  "traefik_integration": {
    "enabled": true,
    "network_isolation": true,
    "security": {
      "expose_databases": false,
      "minio_public_access": true,
      "security_headers": true
    }
  },
  "settings": {
    "docker_compose_timeout": 300,
    "health_check_timeout": 120,
    "backup_parallel_jobs": 2,
    "network_isolation_enforced": true
  },
  "required_secrets": [
    "postgres_password.txt",
    "neo4j_auth.txt",
    "minio_user.txt",
    "minio_password.txt"
  ],
  "password_validation": {
    "enabled": true,
    "requirements": {
      "pattern": "^[a-z0-9]+$",
      "description": "lowercase alphanumeric only (a-z, 0-9)",
      "min_length": 12,
      "max_length": 128,
      "forbidden_chars": ["@", "#", "%", "&", ":", ";", "/", "\\", "?", "=", "+", " "],
      "reason": "Special characters break URL parsing in database connection strings"
    },
    "affected_services": [
      "postgres", "neo4j", "minio"
    ],
    "validation_on_startup": true,
    "fail_on_invalid_passwords": true
  },
  "minio_configuration": {
    "bucket_naming": {
      "dev": "app-files-dev",
      "staging": "app-files-staging", 
      "prod": "app-files-prod"
    },
    "server_urls": {
      "dev": "http://localhost:9000",
      "staging": "https://files-staging.karnagt.com",
      "prod": "https://files.myappdomain.com",
      "prod_aws": "https://files.karnagt.com"
    }
  },
  "context_validation": {
    "description": "Docker context validation rules for deployment safety",
    "enabled_environments": ["prod_aws"],
    "prod_aws": {
      "validation_level": "strict",
      "blocked_contexts": ["default", "desktop-linux"],
      "allowed_context_patterns": [
        "aws-*",
        "*-aws-*", 
        "*-prod*",
        "*prod*",
        "*-ec2-*",
        "*ec2*"
      ],
      "aws_detection_enabled": true,
      "countdown_seconds": 8,
      "error_messages": {
        "blocked_context": "Context '{context}' is blocked for {environment} deployments for security reasons",
        "disallowed_pattern": "Context '{context}' doesn't match allowed patterns for {environment}",
        "aws_warning": "Context '{context}' doesn't appear to be AWS-related. Expected: aws, prod, production, or ec2 indicators"
      },
      "deployment_instructions": [
        "Create AWS-specific Docker context:",
        "  docker context create aws-prod --docker \"host=ssh://ec2-user@YOUR-IP\"",
        "  docker context use aws-prod",
        "",
        "Or deploy directly on AWS instance:",
        "  ssh -i key.pem ec2-user@YOUR-IP"
      ]
    }
  }
}