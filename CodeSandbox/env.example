# CodeSandbox Environment Configuration
# Copy this to .env and customize for your environment

# === Application Settings ===
APP_NAME=CodeSandbox
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# === Server Configuration ===
HOST=127.0.0.1
PORT=8080
WORKERS=1

# === Jupyter Server Configuration ===
JUPYTER_HOST=127.0.0.1
JUPYTER_PORT=8888
JUPYTER_TOKEN=dev-token-12345
JUPYTER_PASSWORD=

# === Workspace Configuration ===
WORKSPACE_BASE_PATH=./workspaces
WORKSPACE_DEFAULT_TTL_HOURS=2
WORKSPACE_MAX_TTL_HOURS=24
WORKSPACE_CLEANUP_INTERVAL_MINUTES=15

# === File Management ===
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_WORKSPACE=50
MAX_WORKSPACE_SIZE_MB=500
ALLOWED_FILE_EXTENSIONS=.py,.txt,.csv,.json,.yaml,.yml,.md,.pdf,.png,.jpg,.jpeg

# === Security Configuration ===
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# === Execution Configuration ===
DEFAULT_EXECUTION_TIMEOUT=30
MAX_EXECUTION_TIMEOUT=300
BLOCKED_IMPORTS=subprocess,os.system,eval,exec,requests,urllib,socket,http

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=/var/log/codesandbox.log 